{
  "name": "aporia-ai-evaluator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first, evidence-first evaluation of claims, discoverability, AI answers, and attribution.",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "test": "node --test --test-reporter=spec \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:boundaries": "node scripts/check-boundaries.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run check:boundaries && npm test",
    "backup": "node scripts/backup.ts",
    "restore": "node scripts/restore.ts"
  },
  "dependencies": {
    "busboy": "1.6.0",
    "parse5": "8.0.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/busboy": "1.5.5",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  }
}
